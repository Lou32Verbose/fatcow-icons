<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>fatcow</id>
    <version>1.0.0</version>
    <authors>FatCow Web Hosting</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="file">LICENSE.md</license>
    <readme>README.md</readme>
    <projectUrl>https://github.com/Lou32Verbose/fatcow-icons</projectUrl>
    <repository type="git" url="https://github.com/Lou32Verbose/fatcow-icons.git" commit="$RepositoryCommit$" />
    <description>3,926 FatCow Farm-Fresh icons in four PNG variants (16px, 32px, color and grey), with CSS sprites and an offline catalogue. No runtime dependencies.</description>
    <contentFiles><files include="any/any/**/*" buildAction="Content" copyToOutput="true" flatten="false" /></contentFiles>
    <tags>fatcow icons png sprite</tags>
  </metadata>
  <files>
    <file src="..\..\dist\**\*" target="content\fatcow" />
    <file src="..\..\dist\**\*" target="contentFiles\any\any\fatcow" />
    <file src="..\..\LICENSE.md" target="" />
    <file src="..\..\NOTICE.md" target="" />
    <file src="..\..\README.md" target="" />
    <file src="..\..\docs\**\*" target="docs" />
  </files>
</package>
